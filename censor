const chars = ['*', '^', '@', '#', '%', '$'];

function censorMessage(player, message, badWords) {
    let censoredMessage = message;
    censoredMessage = normalizeMessage(censoredMessage); //normalize
    const originalMessage = censoredMessage;

    badWords.forEach(badWord => {
        // ignore charss
        const wordPattern = badWord.split('').join('[\\s\\.]*');
        const regex = new RegExp(wordPattern, 'gi');

        censoredMessage = censoredMessage.replace(regex, match => {
            // only letters
            const cleanMatch = match.replace(/\W/g, '');
            if (cleanMatch.length <= 1) {
                return match; 
            }
            // censor mask
            let mask = '';
            for (let index = 0; index < cleanMatch.length - 2; index++) {
                const rNumber = Math.floor(Math.random() * 6) //random
                mask += chars[rNumber];
            }
            return match[0] + mask + match[match.length - 1];
        });
    });

    if (censoredMessage !== originalMessage) {
        setTimeout(() => {
            room.sendAnnouncement(
                `⭐️ ${randomPrefixExpression()} ${player.name}, ${randomExpression()}!`,
                player.id,
                redColor,
                'bold',
                HaxNotification.CHAT
            );
        }, 200);
    }

    // Sprawdzenie i dodanie kropki
    if (!['.', '?', '!'].includes(censoredMessage.at(-1))) {
        censoredMessage += '.';
    }

    // capitalize
    censoredMessage = capitalizeFirstLetter(censoredMessage);

    return censoredMessage;
}